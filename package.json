{
  "name": "soroban-rentwatch-backend",
  "version": "1.0.0",
  "description": "Off-chain multi-tenant Soroban contract TTL monitoring and automated rent-bumping system",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "db:push": "node scripts/prisma-env.cjs db push",
    "db:generate": "node scripts/prisma-env.cjs generate",
    "db:migrate": "node scripts/prisma-env.cjs migrate dev",
    "db:studio": "node scripts/prisma-env.cjs studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@stellar/stellar-sdk": "^13.1.0",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "node-cron": "^3.0.3",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
